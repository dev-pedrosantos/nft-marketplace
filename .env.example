# Base URL of the REST API consumed through Axios. Relative URLs use the app origin.
VITE_API_URL=/api

# Socket.IO server URL. Leave empty to use the app origin.
# With mocks enabled in development, use an origin different from the Vite dev server
# (e.g. http://localhost:3001) so the Socket.IO mock does not capture Vite's HMR WebSocket.
VITE_SOCKET_URL=http://localhost:3001

# "true" starts the MSW worker (REST + Socket.IO simulation) before the app renders.
VITE_ENABLE_MOCKS=true
